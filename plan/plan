#!/bin/sh
# Generated by scoping-plan (plan.mjs install): runs the skill's plan.mjs for this plan folder.
#   ./plan resume · ./plan next · ./plan q ask · ./plan done <piece> --review "…"
here="$(cd "$(dirname "$0")" && pwd)"
for d in "$SCOPING_PLAN_DIR" "$HOME/.claude/skills/scoping-plan" "$HOME/.agents/skills/scoping-plan"; do
  if [ -n "$d" ] && [ -f "$d/scripts/plan.mjs" ]; then exec node "$d/scripts/plan.mjs" "$@" --dir "$here"; fi
done
echo "scoping-plan skill not found — set SCOPING_PLAN_DIR to the skill folder" >&2; exit 1
