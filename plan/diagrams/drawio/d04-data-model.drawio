        <mxCell id="table" value="methods  (JSON)&lt;br&gt;&lt;span style=&quot;font-size:10.5px;font-weight:400;font-family:JetBrains Mono,ui-monospace,monospace;color:inherit;opacity:.85&quot;&gt;info · commands · exec · run&lt;br&gt;props · get · set&lt;br&gt;open · save · saveAs · new&lt;br&gt;frame · export · template.*&lt;br&gt;script · replay · timings&lt;br&gt;mcp&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Inter;fontSize=12.5;fontStyle=1;align=left;verticalAlign=top;spacing=8;spacingTop=10;fillColor=#e0368f;strokeColor=#e0368f;fontColor=#121212;" vertex="1" parent="1"><mxGeometry x="960" y="136" width="380" height="176" as="geometry"/></mxCell>
