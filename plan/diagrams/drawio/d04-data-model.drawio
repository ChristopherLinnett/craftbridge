<mxfile host="drawio-cli" agent="scoping-plan" version="31.4.5">
  <diagram id="d04-data-model" name="What crosses each boundary">
    <mxGraphModel dx="0" dy="0" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="544" math="0" shadow="0" background="none" adaptiveColors="none">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t1" value="One Engine object carries JSON requests; the typed layer is generated from the engine itself" style="text;html=1;whiteSpace=wrap;fontFamily=Inter;fontSize=18;fontColor=#e3e3e3;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="30" as="geometry"/></mxCell>
        <mxCell id="t2" value="Native boundary in §14 · method table in §14 · api-surface.json in §21" style="text;html=1;whiteSpace=wrap;fontFamily=Inter;fontSize=12;fontColor=#9a9a9a;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="900" height="22" as="geometry"/></mxCell>
        <mxCell id="lg_new" value="New" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Inter;fontSize=10.5;fontStyle=1;align=center;verticalAlign=middle;spacing=8;fillColor=#e0368f;strokeColor=#e0368f;fontColor=#121212;" vertex="1" parent="1"><mxGeometry x="1010" y="30" width="120" height="28" as="geometry"/></mxCell>
        <mxCell id="typed" value="TYPED LAYER&lt;span style=&quot;font-weight:400;color:#9a9a9a&quot;&gt;  ·  Swift · Kotlin&lt;/span&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fontFamily=Inter;fontSize=11;fontStyle=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;fillColor=#1f1f1f;strokeColor=#343434;fontColor=#9a9a9a;" vertex="1" parent="1"><mxGeometry x="40" y="92" width="380" height="412" as="geometry"/></mxCell>
        <mxCell id="surface" value="api-surface.json  (generated)&lt;br&gt;&lt;span style=&quot;font-size:10.5px;font-weight:400;font-family:JetBrains Mono,ui-monospace,monospace;color:inherit;opacity:.85&quot;&gt;app · engineVersion · pin&lt;br&gt;commands[763]&lt;br&gt;&amp;nbsp;&amp;nbsp;id · label · params&lt;br&gt;&amp;nbsp;&amp;nbsp;keys: name · required&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;type · values&lt;br&gt;tools[27]: name · inputSchema&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Inter;fontSize=12.5;fontStyle=1;align=left;verticalAlign=top;spacing=8;spacingTop=10;fillColor=#e0368f;strokeColor=#e0368f;fontColor=#121212;" vertex="1" parent="1"><mxGeometry x="60" y="136" width="340" height="176" as="geometry"/></mxCell>
        <mxCell id="boundary" value="NATIVE BOUNDARY&lt;span style=&quot;font-weight:400;color:#9a9a9a&quot;&gt;  ·  UniFFI&lt;/span&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fontFamily=Inter;fontSize=11;fontStyle=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;fillColor=#1f1f1f;strokeColor=#343434;fontColor=#9a9a9a;" vertex="1" parent="1"><mxGeometry x="480" y="92" width="400" height="412" as="geometry"/></mxCell>
        <mxCell id="engine" value="Engine  (object)&lt;br&gt;&lt;span style=&quot;font-size:10.5px;font-weight:400;font-family:JetBrains Mono,ui-monospace,monospace;color:inherit;opacity:.85&quot;&gt;request(method, params) → JSON&lt;br&gt;request_with_progress(…)&lt;br&gt;frame(params, format) → bytes&lt;br&gt;mcp(line) → line?&lt;br&gt;present · suspend_gpu · close&lt;br&gt;errors: CraftError (8 kinds)&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Inter;fontSize=12.5;fontStyle=1;align=left;verticalAlign=top;spacing=8;spacingTop=10;fillColor=#e0368f;strokeColor=#e0368f;fontColor=#121212;" vertex="1" parent="1"><mxGeometry x="500" y="136" width="360" height="176" as="geometry"/></mxCell>
        <mxCell id="folders" value="Folders  (record)&lt;br&gt;&lt;span style=&quot;font-size:10.5px;font-weight:400;font-family:JetBrains Mono,ui-monospace,monospace;color:inherit;opacity:.85&quot;&gt;container · bundle?&lt;br&gt;config · cache · models&lt;br&gt;plugins?&amp;nbsp;&amp;nbsp;&amp;nbsp;none = plug-ins off&lt;br&gt;fonts[]&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Inter;fontSize=12.5;fontStyle=1;align=left;verticalAlign=top;spacing=8;spacingTop=10;fillColor=#e0368f;strokeColor=#e0368f;fontColor=#121212;" vertex="1" parent="1"><mxGeometry x="500" y="360" width="360" height="124" as="geometry"/></mxCell>
