<mxfile host="drawio-cli" agent="scoping-plan" version="31.4.5">
  <diagram id="d01-journey" name="From a desktop template to a card exported on a phone">
    <mxGraphModel dx="0" dy="0" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="430" math="0" shadow="0" background="none" adaptiveColors="none">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t1" value="A template made on the desktop becomes a card exported on the phone" style="text;html=1;whiteSpace=wrap;fontFamily=Inter;fontSize=18;fontColor=#e3e3e3;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="960" height="30" as="geometry"/></mxCell>
        <mxCell id="t2" value="Running example: Leo builds Postcard Studio; Maya makes Sam’s birthday card (1080 × 1080, 30 fps, 6 s, 180 frames)" style="text;html=1;whiteSpace=wrap;fontFamily=Inter;fontSize=12;fontColor=#9a9a9a;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="960" height="22" as="geometry"/></mxCell>
        <mxCell id="lg_neutral" value="A person acts" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Inter;fontSize=10.5;fontStyle=1;align=center;verticalAlign=middle;spacing=8;fillColor=#232323;strokeColor=#3a3a3a;fontColor=#c8c8c8;" vertex="1" parent="1"><mxGeometry x="1040" y="30" width="120" height="28" as="geometry"/></mxCell>
        <mxCell id="lg_new" value="CraftBridge" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Inter;fontSize=10.5;fontStyle=1;align=center;verticalAlign=middle;spacing=8;fillColor=#e0368f;strokeColor=#e0368f;fontColor=#121212;" vertex="1" parent="1"><mxGeometry x="1172" y="30" width="120" height="28" as="geometry"/></mxCell>
        <mxCell id="dev" value="LEO BUILDS THE APP&lt;span style=&quot;font-weight:400;color:#9a9a9a&quot;&gt;  ·  once, on his Mac&lt;/span&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fontFamily=Inter;fontSize=11;fontStyle=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;fillColor=#1f1f1f;strokeColor=#343434;fontColor=#9a9a9a;strokeColor=#e0368f;" vertex="1" parent="1"><mxGeometry x="40" y="104" width="438" height="252" as="geometry"/></mxCell>
        <mxCell id="use" value="MAYA MAKES THE CARD&lt;span style=&quot;font-weight:400;color:#9a9a9a&quot;&gt;  ·  on her iPhone 15 (Metal) · a friend on a Pixel 8 (Vulkan)&lt;/span&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fontFamily=Inter;fontSize=11;fontStyle=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;fillColor=#1f1f1f;strokeColor=#343434;fontColor=#9a9a9a;" vertex="1" parent="1"><mxGeometry x="518" y="104" width="840" height="252" as="geometry"/></mxCell>
        <mxCell id="s1" value="①  Designs the card&lt;br&gt;&lt;span style=&quot;font-size:10.5px;font-weight:400;color:inherit;opacity:.85&quot;&gt;In EffectCraft: “Social Square” template + Name and Photo controls → Birthday Card.ectemplate&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Inter;fontSize=14;fontStyle=1;align=left;verticalAlign=top;spacing=8;spacingTop=10;fillColor=#232323;strokeColor=#3a3a3a;fontColor=#c8c8c8;" vertex="1" parent="1"><mxGeometry x="64" y="164" width="180" height="132" as="geometry"/></mxCell>
        <mxCell id="s2" value="②  Adds CraftBridge&lt;br&gt;&lt;span style=&quot;font-size:10.5px;font-weight:400;color:inherit;opacity:.85&quot;&gt;Swift package or Gradle library; bundles the template in the app&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Inter;fontSize=14;fontStyle=1;align=left;verticalAlign=top;spacing=8;spacingTop=10;fillColor=#e0368f;strokeColor=#e0368f;fontColor=#121212;" vertex="1" parent="1"><mxGeometry x="274" y="164" width="180" height="132" as="geometry"/></mxCell>
        <mxCell id="s3" value="③  Fills in the card&lt;br&gt;&lt;span style=&quot;font-size:10.5px;font-weight:400;color:inherit;opacity:.85&quot;&gt;Name = “Sam”, a photo from her library&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Inter;fontSize=14;fontStyle=1;align=left;verticalAlign=top;spacing=8;spacingTop=10;fillColor=#232323;strokeColor=#3a3a3a;fontColor=#c8c8c8;" vertex="1" parent="1"><mxGeometry x="542" y="164" width="180" height="132" as="geometry"/></mxCell>
        <mxCell id="s4" value="④  Live preview&lt;br&gt;&lt;span style=&quot;font-size:10.5px;font-weight:400;color:inherit;opacity:.85&quot;&gt;Drawn on the GPU straight into the app’s own view&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Inter;fontSize=14;fontStyle=1;align=left;verticalAlign=top;spacing=8;spacingTop=10;fillColor=#e0368f;strokeColor=#e0368f;fontColor=#121212;" vertex="1" parent="1"><mxGeometry x="746" y="164" width="180" height="132" as="geometry"/></mxCell>
        <mxCell id="s5" value="⑤  Exports&lt;br&gt;&lt;span style=&quot;font-size:10.5px;font-weight:400;color:inherit;opacity:.85&quot;&gt;MP4, 180 frames, progress bar; continues in the background&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Inter;fontSize=14;fontStyle=1;align=left;verticalAlign=top;spacing=8;spacingTop=10;fillColor=#e0368f;strokeColor=#e0368f;fontColor=#121212;" vertex="1" parent="1"><mxGeometry x="950" y="164" width="180" height="132" as="geometry"/></mxCell>
        <mxCell id="s6" value="⑥  Shares the card&lt;br&gt;&lt;span style=&quot;font-size:10.5px;font-weight:400;color:inherit;opacity:.85&quot;&gt;The file never left the phone&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Inter;fontSize=14;fontStyle=1;align=left;verticalAlign=top;spacing=8;spacingTop=10;fillColor=#232323;strokeColor=#3a3a3a;fontColor=#c8c8c8;" vertex="1" parent="1"><mxGeometry x="1154" y="164" width="180" height="132" as="geometry"/></mxCell>
        <mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jumpStyle=arc;jumpSize=7;html=1;fontFamily=Inter;fontSize=10.5;strokeWidth=1.6;endArrow=block;endFill=1;startArrow=none;startFill=1;labelBackgroundColor=#121212;strokeColor=#707070;fontColor=#c8c8c8;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jumpStyle=arc;jumpSize=7;html=1;fontFamily=Inter;fontSize=10.5;strokeWidth=1.6;endArrow=block;endFill=1;startArrow=none;startFill=1;labelBackgroundColor=#121212;strokeColor=#707070;fontColor=#c8c8c8;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jumpStyle=arc;jumpSize=7;html=1;fontFamily=Inter;fontSize=10.5;strokeWidth=1.6;endArrow=block;endFill=1;startArrow=none;startFill=1;labelBackgroundColor=#121212;strokeColor=#707070;fontColor=#c8c8c8;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jumpStyle=arc;jumpSize=7;html=1;fontFamily=Inter;fontSize=10.5;strokeWidth=1.6;endArrow=block;endFill=1;startArrow=none;startFill=1;labelBackgroundColor=#121212;strokeColor=#707070;fontColor=#c8c8c8;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s4" target="s5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jumpStyle=arc;jumpSize=7;html=1;fontFamily=Inter;fontSize=10.5;strokeWidth=1.6;endArrow=block;endFill=1;startArrow=none;startFill=1;labelBackgroundColor=#121212;strokeColor=#707070;fontColor=#c8c8c8;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s5" target="s6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e8" value="cancel → export again" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jumpStyle=arc;jumpSize=7;html=1;fontFamily=Inter;fontSize=10.5;strokeWidth=1.6;endArrow=block;endFill=1;startArrow=none;startFill=1;labelBackgroundColor=#121212;strokeColor=#e04a3c;fontColor=#e04a3c;dashed=1;dashPattern=6 4;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="s5" target="s5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="995" y="336"/><mxPoint x="1085" y="336"/></Array></mxGeometry></mxCell>
        <mxCell id="t9" value="Same engine as the EffectCraft desktop app: a frame rendered on the CPU is byte-for-byte the same on the iPhone, the Pixel and the Mac." style="text;html=1;whiteSpace=wrap;fontFamily=Inter;fontSize=12;fontColor=#c8c8c8;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="380" width="1320" height="24" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
