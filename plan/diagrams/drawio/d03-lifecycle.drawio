<mxfile host="drawio-cli" agent="scoping-plan" version="31.4.5">
  <diagram id="d03-lifecycle" name="An engine’s life inside an app">
    <mxGraphModel dx="0" dy="0" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="478" math="0" shadow="0" background="none" adaptiveColors="none">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t1" value="An engine serves calls in order, exports one job at a time and falls back to the CPU" style="text;html=1;whiteSpace=wrap;fontFamily=Inter;fontSize=18;fontColor=#e3e3e3;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="760" height="30" as="geometry"/></mxCell>
        <mxCell id="t2" value="One EffectCraft session per engine, on its own thread (L1–L7)" style="text;html=1;whiteSpace=wrap;fontFamily=Inter;fontSize=12;fontColor=#9a9a9a;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="760" height="22" as="geometry"/></mxCell>
        <mxCell id="lg_neutral" value="State" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Inter;fontSize=10.5;fontStyle=1;align=center;verticalAlign=middle;spacing=8;fillColor=#232323;strokeColor=#3a3a3a;fontColor=#c8c8c8;" vertex="1" parent="1"><mxGeometry x="840" y="30" width="120" height="28" as="geometry"/></mxCell>
        <mxCell id="lg_warn" value="Failure" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Inter;fontSize=10.5;fontStyle=1;align=center;verticalAlign=middle;spacing=8;fillColor=#e04a3c;fillOpacity=18;strokeColor=#e04a3c;fontColor=#e3e3e3;" vertex="1" parent="1"><mxGeometry x="972" y="30" width="120" height="28" as="geometry"/></mxCell>
        <mxCell id="start" value="Starting&lt;br&gt;&lt;span style=&quot;font-size:10.5px;font-weight:400;color:inherit;opacity:.85&quot;&gt;folders · session · GPU if any&lt;/span&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontFamily=Inter;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;spacing=8;fillColor=#232323;strokeColor=#3a3a3a;fontColor=#c8c8c8;" vertex="1" parent="1"><mxGeometry x="60" y="132" width="240" height="76" as="geometry"/></mxCell>
        <mxCell id="ready" value="Ready&lt;br&gt;&lt;span style=&quot;font-size:10.5px;font-weight:400;color:inherit;opacity:.85&quot;&gt;calls run in order (L1)&lt;/span&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontFamily=Inter;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;spacing=8;fillColor=#232323;strokeColor=#3a3a3a;fontColor=#c8c8c8;" vertex="1" parent="1"><mxGeometry x="400" y="132" width="240" height="76" as="geometry"/></mxCell>
        <mxCell id="export" value="Exporting&lt;br&gt;&lt;span style=&quot;font-size:10.5px;font-weight:400;color:inherit;opacity:.85&quot;&gt;only progress, cancel, info (L3)&lt;/span&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontFamily=Inter;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;spacing=8;fillColor=#232323;strokeColor=#3a3a3a;fontColor=#c8c8c8;" vertex="1" parent="1"><mxGeometry x="740" y="132" width="240" height="76" as="geometry"/></mxCell>
        <mxCell id="failed" value="Failed to start&lt;br&gt;&lt;span style=&quot;font-size:10.5px;font-weight:400;color:inherit;opacity:.85&quot;&gt;folders not writable → Io&lt;/span&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontFamily=Inter;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;spacing=8;fillColor=#e04a3c;fillOpacity=18;strokeColor=#e04a3c;fontColor=#e3e3e3;" vertex="1" parent="1"><mxGeometry x="60" y="312" width="240" height="76" as="geometry"/></mxCell>
        <mxCell id="cpu" value="CPU only&lt;br&gt;&lt;span style=&quot;font-size:10.5px;font-weight:400;color:inherit;opacity:.85&quot;&gt;GPU lost, refused or suspended (L7)&lt;/span&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontFamily=Inter;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;spacing=8;fillColor=#232323;strokeColor=#3a3a3a;fontColor=#c8c8c8;" vertex="1" parent="1"><mxGeometry x="400" y="312" width="240" height="76" as="geometry"/></mxCell>
        <mxCell id="closed" value="Closed&lt;br&gt;&lt;span style=&quot;font-size:10.5px;font-weight:400;color:inherit;opacity:.85&quot;&gt;export stopped · GPU released&lt;/span&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontFamily=Inter;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;spacing=8;fillColor=#232323;strokeColor=#3a3a3a;fontColor=#c8c8c8;" vertex="1" parent="1"><mxGeometry x="740" y="312" width="240" height="76" as="geometry"/></mxCell>
        <mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jumpStyle=arc;jumpSize=7;html=1;fontFamily=Inter;fontSize=10.5;strokeWidth=1.6;endArrow=block;endFill=1;startArrow=none;startFill=1;labelBackgroundColor=#121212;strokeColor=#707070;fontColor=#c8c8c8;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="start" target="ready"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jumpStyle=arc;jumpSize=7;html=1;fontFamily=Inter;fontSize=10.5;strokeWidth=1.6;endArrow=block;endFill=1;startArrow=none;startFill=1;labelBackgroundColor=#121212;strokeColor=#e04a3c;fontColor=#e04a3c;dashed=1;dashPattern=6 4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="start" target="failed"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e5" value="export" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jumpStyle=arc;jumpSize=7;html=1;fontFamily=Inter;fontSize=10.5;strokeWidth=1.6;endArrow=block;endFill=1;startArrow=none;startFill=1;labelBackgroundColor=#121212;strokeColor=#707070;fontColor=#c8c8c8;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="ready" target="export"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e6" value="done · cancelled" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jumpStyle=arc;jumpSize=7;html=1;fontFamily=Inter;fontSize=10.5;strokeWidth=1.6;endArrow=block;endFill=1;startArrow=none;startFill=1;labelBackgroundColor=#121212;strokeColor=#707070;fontColor=#c8c8c8;exitX=0;exitY=0.7;exitDx=0;exitDy=0;entryX=1;entryY=0.7;entryDx=0;entryDy=0;" edge="1" parent="1" source="export" target="ready"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e7" value="GPU lost · background" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jumpStyle=arc;jumpSize=7;html=1;fontFamily=Inter;fontSize=10.5;strokeWidth=1.6;endArrow=block;endFill=1;startArrow=none;startFill=1;labelBackgroundColor=#121212;strokeColor=#707070;fontColor=#c8c8c8;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ready" target="cpu"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e8" value="GPU back" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jumpStyle=arc;jumpSize=7;html=1;fontFamily=Inter;fontSize=10.5;strokeWidth=1.6;endArrow=block;endFill=1;startArrow=none;startFill=1;labelBackgroundColor=#121212;strokeColor=#707070;fontColor=#c8c8c8;exitX=0.7;exitY=0;exitDx=0;exitDy=0;entryX=0.7;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="cpu" target="ready"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e9" value="close" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jumpStyle=arc;jumpSize=7;html=1;fontFamily=Inter;fontSize=10.5;strokeWidth=1.6;endArrow=block;endFill=1;startArrow=none;startFill=1;labelBackgroundColor=#121212;strokeColor=#707070;fontColor=#c8c8c8;exitX=1;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ready" target="closed"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e10" value="close (stops the export)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jumpStyle=arc;jumpSize=7;html=1;fontFamily=Inter;fontSize=10.5;strokeWidth=1.6;endArrow=block;endFill=1;startArrow=none;startFill=1;labelBackgroundColor=#121212;strokeColor=#707070;fontColor=#c8c8c8;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="export" target="closed"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="t11" value="The CPU renderer is the reference in every state; the GPU compositor matches it within its own tolerance." style="text;html=1;whiteSpace=wrap;fontFamily=Inter;fontSize=12;fontColor=#c8c8c8;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="416" width="920" height="22" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
