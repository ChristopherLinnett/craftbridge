#!/usr/bin/env bash
# Runs the gate before every push (AGENTS.md), on the commits the push carries and not on the working
# tree the push happens to come from: what is pushed is what is judged, so an uncommitted or untracked
# edit neither passes nor fails the push beside it. Each commit the push carries is checked out into a
# temporary worktree of this repository, that commit's own tools/ci.sh runs there, and the worktree goes
# again whether the gate passed or failed.
# Installed by `tools/doctor.sh --install-hooks`.
set -euo pipefail
# Git exports its repository variables (GIT_DIR and the rest) to a hook, and a push may carry more of them
# in its own environment; a push from a linked worktree names that worktree's own index and git folder.
# They go before the hook's first git command, as ci.sh clears them for the gate: every git command here,
# and every one the gate runs, finds its repository from the folder it runs in.
# shellcheck disable=SC2046 # one variable name per word, split on purpose
unset $(git rev-parse --local-env-vars 2>/dev/null)
# Every word the hook writes goes to stderr through say. A client can stop reading the push's stderr — a GUI
# client, an IDE, a script that gave up — and leave it a closed pipe. A word bash's own printf writes there
# raises SIGPIPE, and bash ends on it, running its EXIT trap first; but bash keeps what printf could not
# write and hands it to the trap's command substitutions, where it passes for their answer: the release
# would read its own lock as another push's and leave it standing, and the push would be refused. The
# printf program takes the SIGPIPE itself and leaves nothing behind, so a word no one reads changes nothing
# the hook does.
say() { env printf "$@" >&2 || true; }

# Git names the remote and the URL the push goes to, and gives one line per ref on stdin: <local ref>
# <local sha> <remote ref> <remote sha>. Every line is read before any gate runs, so nothing a gate starts
# can read the lines meant for the hook.
destination="$2"
tips=()
while read -r _ local_sha _ _; do
  # A ref the push deletes comes with an all-zero local sha, which names no object, and a tag of a tree or
  # a blob names no commit: neither carries a commit to gate, so a push that only deletes branches is not
  # gated, and does not even ask the remote what it holds.
  if git rev-parse --quiet --verify "$local_sha^{commit}" >/dev/null; then tips+=("$local_sha"); fi
done
if [ ${#tips[@]} -eq 0 ]; then exit 0; fi
# What the remote holds is asked of the very URL the push goes to: every object its refs name, as
# `git ls-remote` lists them. The remote's name would not do, for a remote can fetch from one place and
# push to another (a fork's pushurl); nor would this repository's remote-tracking refs, which go on naming
# a branch the remote has since deleted, so that the commits only that branch held would pass ungated, and
# which do not exist at all when the push names a URL. A push that cannot ask is refused, not judged
# against what this repository last heard.
if ! advertised="$(git ls-remote "$destination")"; then
  say 'pre-push: refused: could not ask %s which commits it holds\n' "$destination"
  exit 1
fi
# The commits the push carries: every one the new tips reach that none of the remote's refs reaches. Each
# is a pushed commit, so each is gated, not only the tip a ref names; the same commit behind two refs is
# gated once, and each after every commit it stands on, so a refusal names the earliest trouble first. A
# walk by date alone would meet a parent before a child dated earlier on another branch; --topo-order
# keeps every parent after all its children, and --reverse turns that round. An object the remote names
# that this repository never fetched cannot bound the walk and is passed over (--ignore-missing), so what
# the hook cannot prove the remote holds, it gates.
commits="$(if [ -n "$advertised" ]; then printf '%s\n' "$advertised" | cut -f1 | sed 's/^/^/'; fi |
  git rev-list --reverse --topo-order --ignore-missing "${tips[@]}" --stdin)"
if [ -z "$commits" ]; then exit 0; fi

# The folder this hook keeps for the repository, in its common git folder, so every worktree's push finds
# the same one: the lock that lets one gate run at a time, the record of the worktree a gate runs in, and
# the build folder the gates share with the number that names it.
area="$(git rev-parse --path-format=absolute --git-common-dir)/craftbridge-pre-push"
mkdir -p "$area"
lock="$area/lock"
# Something stands at one of the hook's names that no push made: the push is refused, naming it, and
# nothing there is touched, so a person can see it and decide.
refuse_foreign() {
  say 'pre-push: refused: %s is not a %s this hook made; remove it, and pushes gate again\n' "$1" "$2"
  exit 1
}
# The record and the folder number are files this hook writes, or nothing yet. A folder at the number's
# name would take each new number inside itself, so no broken lock would ever retire the build folder a
# dead holder's gate still writes to; a link at either name would have the hook read or write through it.
for kept in "$area/tree" "$area/generation"; do
  if [ -L "$kept" ] || { [ -e "$kept" ] && [ ! -f "$kept" ]; }; then refuse_foreign "$kept" file; fi
done
# A process is named by its pid and its start time, so a pid the system has since given to another
# process is never taken for the lock's holder. ps prints the start in the locale's words and the time
# zone's hours, and two pushes need not share either: LC_ALL and TZ are fixed, or a waiter would read a
# live holder's start another way than the holder wrote it, take it for dead and break its lock.
started() { LC_ALL=C TZ=UTC0 ps -o lstart= -p "$1" 2>/dev/null; }
me="$$ $(started $$ || true)"
# Is the process a lock names gone? Only a start ps reads, and reads differently, says the pid has passed
# to another process. When ps cannot answer, or the holder could not name its own start, the kernel is
# asked whether the pid is in use at all: a holder this hook cannot judge is taken for a live one, so a
# failing ps makes a push wait rather than break a lock in use.
gone() {
  local pid="${1%% *}" recorded="${1#* }" start
  if [ -n "$recorded" ] && start="$(started "$pid")"; then
    [ "$start" != "$recorded" ]
  elif kill -0 "$pid" 2>/dev/null; then
    return 1
  fi
}
# Makes the link $1 name this process. `ln -sn` creates it and names its holder in one atomic step, and
# fails while anything stands at the name; the -n makes it fail, too, on a link to a folder, which plain
# ln would follow. A real folder at the name still takes the link inside itself, and ln succeeds, so the
# claim holds only once the name reads back as this process's link. Returns 1 while another holds the
# name. Anything but a link there was never made by a push and names no holder to wait for: the push is
# refused, naming it, rather than let through unserialised or left waiting for ever.
claim() {
  local err=""
  for _ in 1 2; do
    if err="$(ln -sn "$me" "$1" 2>&1)"; then
      if [ "$(readlink "$1" 2>/dev/null || true)" = "$me" ]; then return 0; fi
      rm -f "$1/$me"
    fi
    if [ -L "$1" ]; then return 1; fi
    if [ -e "$1" ]; then refuse_foreign "$1" lock; fi
    # Nothing stands there: its holder let go between the two looks, so the claim is made once more.
  done
  say 'pre-push: refused: could not make the lock %s: %s\n' "$1" "$err"
  exit 1
}
# What the name $1 holds in its own words: a lock names its holder in its link target, a record file in
# its first line. Read through this, the one compare-and-restore below serves both kinds.
held_under() {
  if [ -L "$1" ]; then readlink "$1" 2>/dev/null; else head -n 1 "$1" 2>/dev/null; fi
}
# Removes the lock or record $1 only while it holds $2. A plain rm could remove what another hook made in
# the instant since this one read it: the name is moved aside to one of this process's own, which is
# atomic, and read there. A name holding anyone else's words is put back as it was. So is a name holding
# neither's, which no push made: a hook that threw it away would destroy the very sign that tells the next
# push — and the person it refuses by name — that no lock stands here, and would have deleted what was
# never its.
remove_if_names() {
  local aside="$1.$$"
  mv "$1" "$aside" 2>/dev/null || return 0
  if [ "$(held_under "$aside")" != "$2" ]; then
    if [ -L "$aside" ]; then ln -sn "$(readlink "$aside")" "$1" 2>/dev/null || true
    else mv "$aside" "$1" 2>/dev/null || true
    fi
  fi
  rm -f "$aside"
}
holding=0
# The gates' build folder is the one numbered in $area/generation, so a folder can be retired by moving
# the number on.
generation() {
  local n
  n="$(cat "$area/generation" 2>/dev/null || true)"
  case "$n" in '' | *[!0-9]*) n=0 ;; esac
  printf '%s' "$n"
}
tmp=""
tree=""
made_tree=0
cleanup() {
  # Every way out of the hook a trap can see cleans up, a signal included, so nothing of a refused or
  # interrupted push stays registered in the repository or holds up the next push.
  if [ "$made_tree" = 1 ]; then git worktree remove --force "$tree" 2>/dev/null || rm -rf "$tree"; fi
  if [ -n "$tmp" ]; then rm -rf "$tmp"; fi
  if [ "$holding" = 1 ]; then
    remove_if_names "$area/tree" "$tree"
    remove_if_names "$lock" "$me"
  fi
}
trap cleanup EXIT
# A gate that turns Ctrl-C into an ordinary exit, as Gradle's JVM does, leaves bash taking the interrupt
# for one the gate handled, and it would go on to gate the next commit; this ends the hook there. A TERM or
# a HUP ends bash anyway, through the EXIT trap.
trap 'exit 1' INT

# The lock is a link naming the push that holds it (claim).
waiting=0
until claim "$lock"; do
  holder="$(readlink "$lock" 2>/dev/null || true)"
  if [ -z "$holder" ]; then continue; fi
  if gone "$holder"; then
    # Its holder died without its trap (killed outright, or the machine went down). A hook killed outright
    # leaves its gate's processes running, still building into the folder they were handed, so that
    # folder is retired before the lock goes: every later gate builds into a new one, which those
    # processes never name. The lock goes only while it still names the dead holder, so a waiter that
    # breaks it just after another has broken it, and a new push taken it, puts that push's lock back.
    printf '%s\n' "$(($(generation) + 1))" >"$area/generation.$$"
    mv -f "$area/generation.$$" "$area/generation"
    remove_if_names "$lock" "$holder"
    continue
  fi
  if [ "$waiting" = 0 ]; then
    # The lock names its holder, so the wait names it too: whoever waits sees which push to look at,
    # and can judge for themselves when the hook holding it is never coming back.
    say 'pre-push: waiting for the gate of another push of this repository to finish (lock %s held by %s)\n' "$lock" "$holder"
    waiting=1
  fi
  sleep 1
done
holding=1
# A hook that died without its trap left its worktree registered; the next to hold the lock removes it,
# and the temporary folder it sat in.
if [ -f "$area/tree" ]; then
  leftover="$(cat "$area/tree")"
  git worktree remove --force "$leftover" 2>/dev/null || true
  rmdir "${leftover%/*}" 2>/dev/null || true
fi
# The commit is checked out outside the repository's folders: Cargo merges a .cargo/config.toml from
# every folder above the one it builds in, and one in the checkout the push comes from must not reach a
# gate that judges only the commit. The folder is made only once the lock is held, and recorded at once,
# so a hook killed outright, which runs no trap, leaves no folder the next push does not know of.
tmp="$(mktemp -d "${TMPDIR:-/tmp}/craftbridge-pre-push.XXXXXX")"
tree="$tmp/${tmp##*/}"
printf '%s\n' "$tree" >"$area/tree"

# One build folder for every gate of this repository, kept warm from push to push (tools/env.sh). Sharing
# it is safe because one gate runs at a time and each commit is checked out only once the lock is held:
# every file a gate builds is then newer than every artifact in the folder, so Cargo rebuilds the
# workspace's own crates rather than take another tree's artifacts for this one's, and reuses only what
# is keyed by version or revision, which no checkout changes. A folder a broken lock retired goes now.
CRAFTBRIDGE_PUSH_TARGET="$area/target-$(generation)"
export CRAFTBRIDGE_PUSH_TARGET
for retired in "$area"/target-*; do
  if [ "$retired" != "$CRAFTBRIDGE_PUSH_TARGET" ]; then rm -rf "$retired"; fi
done
failed=""
for commit in $commits; do
  name="$(git log -1 --format='%h %s' "$commit")"
  made_tree=1
  if ! git worktree add --quiet --detach "$tree" "$commit"; then
    say 'pre-push: could not check %s out for the gate\n' "$name"
    exit 1
  fi
  say 'pre-push: gating %s\n' "$name"
  # A gated tree is a fresh checkout, and holds nothing git ignores; one of the gate's prerequisites lives
  # in the tree and is ignored there: the plan kit's dependencies, in plan/node_modules, which the gate's
  # doctor and its plan stage require as plan/package-lock.json pins them. They are installed as the
  # doctor's own fix installs them, `npm ci`, which puts in place exactly what the commit's lock pins:
  # never another tree's install, which may answer to another lock. npm's cache holds every package once
  # for the whole machine, so after the first push the install takes seconds and needs no network. An
  # install that fails is not judged here: the gate's doctor names what is missing.
  if [ -f "$tree/plan/package-lock.json" ]; then
    (cd "$tree/plan" && npm ci --prefer-offline --no-audit --no-fund) >&2 || true
  fi
  # A commit whose tools/ci.sh is gone, or cannot run, fails here as one whose gate fails, never passes
  # unjudged: deleting the gate would otherwise be all it took to switch the gate off.
  if ! "$tree/tools/ci.sh"; then failed="$failed"$'\n'"  $name"; fi
  git worktree remove --force "$tree"
  made_tree=0
done
if [ -n "$failed" ]; then
  say 'pre-push: refused, the gate failed on:%s\n' "$failed"
  exit 1
fi
say 'pre-push: the gate passed on every commit the push carries\n'
