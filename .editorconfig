root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{md,json,yml,yaml}]
indent_size = 2

[*.{kt,kts}]
# ktlint reads these (tools/ci.sh, android/sdk/build-logic).
ktlint_code_style = ktlint_official
max_line_length = 140
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true
# A Composable is named for the thing it draws, in PascalCase, as Compose's API guidelines say.
ktlint_function_naming_ignore_when_annotated_with = Composable
